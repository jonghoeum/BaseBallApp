@using Microsoft.AspNetCore.Components.Forms

<div class="mb-3">
    <InputFile key="@inputKey" @ref="fileInput" OnChange="OnFileChanged" class="form-control" />

    @if (SelectedFile != null)
    {
        <div class="mt-2">
            <span class="badge bg-info text-dark">선택한 파일: @SelectedFile.Name</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="text-danger mt-1">@_errorMessage</div>
    }
</div>

@code {
    private InputFile? fileInput;
    private string inputKey = Guid.NewGuid().ToString(); // ⚠️ 매번 리렌더링 트리거용 key

    [Parameter] public EventCallback<IBrowserFile> OnFileSelected { get; set; }

    private string _errorMessage = string.Empty;
    public IBrowserFile? SelectedFile { get; private set; }

    private async Task OnFileChanged(InputFileChangeEventArgs e)
    {
        if (e.FileCount > 0)
        {
            SelectedFile = e.File;
            _errorMessage = string.Empty;
            await OnFileSelected.InvokeAsync(SelectedFile);
        }
        else
        {
            // 파일 선택 취소됨
            SelectedFile = null;
            _errorMessage = string.Empty;

            // ⚠️ InputFile을 리렌더링하여 상태 초기화
            inputKey = Guid.NewGuid().ToString();
        }
    }
}

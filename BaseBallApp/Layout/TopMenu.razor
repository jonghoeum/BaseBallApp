            <div class="util_menu">
                <ul>
                    <!-- s: LOGOUT -->
                    @* <li>
                        <a id="test" href="/">KO</a>
                        <a href="/EN/index.do">EN</a>
                    </li> *@
                    <!-- s: LOGOUT -->
                    @if (isLoggedIn)
                    {
                        <li><a href="#" @onclick="Logout" @onclick:preventDefault="true">LOGOUT</a></li>
                    }
                    else
                    {
                        <li><a href="#" @onclick="ShowLoginModal" @onclick:preventDefault="true">LOGIN</a></li>
                        <li><a href="#" @onclick="ShowJoinModal" @onclick:preventDefault="true">JOIN US</a></li>
                    }
                </ul>
            </div>
            @* 
            <div class="sns_menu mobile_only">
                <ul>
                    <li><a href="https://www.youtube.com/channel/UCdq4Ji3772xudYRUatdzRrg" class="youtube" target="_blank">youtube 바로가기</a></li>
                    <li><a href="https://www.facebook.com/hanwhaeagles.news/" class="facebook" target="_blank">facebook 바로가기</a></li>
                    <li><a href="https://www.instagram.com/hanwhaeagles_soori" class="instagram" target="_blank">instagram 바로가기</a></li>
                    <li><a href="https://twitter.com/hoodi_thespace" class="twitter" target="_blank">twitter 바로가기</a></li>
                </ul>
            </div> 
            *@
        </div><!-- //.menu_effect -->
        <LoginModal @ref="loginModal" OnLoginResult="OnLoginResult" />
        <JoinModal @ref="joinModal" />
    </div>
    @code {
        private bool isLoggedIn = false;
        private LoginModal? loginModal;
        private JoinModal? joinModal;
        protected override async Task OnInitializedAsync()
        {
            // 세션 스토리지에서 로그인 정보 확인
            var userId = await js.InvokeAsync<string>("sessionStorage.getItem", "UserId");
            isLoggedIn = !string.IsNullOrEmpty(userId);
        }
        private void ShowLoginModal()
        {
            loginModal?.Show();
        }

        private void ShowJoinModal()
        {
            joinModal?.Show();
        }

        private async Task Logout()
        {
            await js.InvokeVoidAsync("sessionStorage.clear");
            isLoggedIn = false;
            NavManager.NavigateTo("/"); // 필요시 메인페이지 이동
        }

        private void OnLoginResult(bool success)
        {
            if (success)
            {
                isLoggedIn = true;
                StateHasChanged();
            }
        }
        private async Task HandleMouseLeave()
        {
            //await js.InvokeVoidAsync("CustomAlert", "전화번호가 정상적이지 않습니다.\n 전화번호를 확인해주세요.");
            await js.InvokeVoidAsync("HeaderOver", "mouseleave");
        }

        private async Task HandleMouseEnter()
        {
            await js.InvokeVoidAsync("HeaderOver", "mouseenter");
        }

        private async Task HandleMouseOver()
        {
            await js.InvokeVoidAsync("HeaderOver", "mouseover");
        }
    }

</header>
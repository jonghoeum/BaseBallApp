                    <li>
                        <a href="/Gallery" class="both"><span style="width: 0px;"></span><span style="width: 0px;"></span>PHOTO</a>
                    </li>
                    <li class="pc_only">
                        <a href="/Notice"><span style="width: 0px;"></span><span style="width: 0px;"></span>NOTICE</a>

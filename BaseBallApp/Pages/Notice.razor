@code {
	private List<NoticeViewModel> NoticeList = new();
	private bool isModalVisible = false;
	private string responseMessage ="";
	private NoticeClass newPost = new();
	private RichTextEdit? editorRef;
	private int PageNum = 1;
	private int PageSize = 10;
	private long TotalCount = 0;
	private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize);
	private int StartPage => ((PageNum - 1) / 10) * 10 + 1;
	private int EndPage => StartPage + 9;

	private NoticeClass editPost = new();
	private bool isEditModalVisible = false;
	private RichTextEdit? editEditorRef;

	protected override async Task OnInitializedAsync()
	{
		await LoadPage(PageNum);
	}
	private async Task LoadPage(int pageNumber)
	{
		PageNum = pageNumber;
		NoticeList = await _NoticeService.GetNoticeAsync(PageNum, PageSize);
		TotalCount = NoticeList.FirstOrDefault()?.TotalCount ?? 0;
	}
	private async Task PreviousPageGroup()
	{
		int prevGroupPage = Math.Max(StartPage - 10, 1);
		await LoadPage(prevGroupPage);
	}

	private async Task NextPageGroup()
	{
		int nextGroupPage = StartPage + 10;
		if (nextGroupPage <= TotalPages)
		{
			await LoadPage(nextGroupPage);
		}
	}
	private async Task RegisterNotices()
	{
		if (editorRef != null)
		{
			newPost.Content = await editorRef.GetHtmlAsync(); // ✅ GetHtmlAsync 제공
		}
		newPost.Other1 = "";
		newPost.Other2 = "";
		newPost.Other3 = "";
		newPost.Other4 = "";
		newPost.Other5 = "";
		//var sucess = await _GameService.InsertGameAsync(regGameWithScores);
		//var succes = await _GalleryService.InsertGalleryAsync(regGal);
		//var succes = true;
		var succes = await _NoticeService.InsertNoticeAsync(newPost);

		if (succes)
		{
			responseMessage = "정상적으로 등록되었습니다.";
			isModalVisible = false;
			newPost = new();
			await js.InvokeVoidAsync("alert", responseMessage);
			await LoadPage(PageNum);
			return;
		}
		else
		{
			responseMessage = "등록시 문제가 발생하였습니다. 관리자에게 문의해주세요";
			await js.InvokeVoidAsync("alert", responseMessage);
			return;
		}
	}
	private void CloseModal()
	{
		isModalVisible = false;
	}

	private async Task OnNoticeClicked(NoticeViewModel noti)
	{
		await _NoticeService.IncrementViewCountAsync(noti.IDX);
		NavManager.NavigateTo($"/notice/detail/{noti.IDX}");
	}

	private void OpenEditModal(NoticeViewModel notice)
	{
		editPost = new NoticeClass
			{
				IDX = notice.IDX,
				Title = notice.Title,
				Content = notice.Content,
				IsNotice = notice.IsNotice,
				ViewCount = notice.ViewCount,
				CreatedAt = notice.CreatedAt
			};
		isEditModalVisible = true;

		// 에디터 초기값 설정을 위해 렌더링 후 내용 적용 필요
		_ = Task.Delay(100).ContinueWith(async _ =>
		{
			if (editEditorRef != null)
			{
				await InvokeAsync(() => editEditorRef.SetHtmlAsync(editPost.Content ?? ""));
			}
		});
	}

	private void CloseEditModal()
	{
		isEditModalVisible = false;
	}

	private async Task UpdateNotice()
	{
		if (editEditorRef != null)
		{
			editPost.Content = await editEditorRef.GetHtmlAsync();
		}

		var success = await _NoticeService.UpdateNoticeAsync(editPost);
		if (success)
		{
			await JSRuntime.InvokeVoidAsync("alert", "수정이 완료되었습니다.");
			isEditModalVisible = false;
			await LoadPage(PageNum);
		}
		else
		{
			await JSRuntime.InvokeVoidAsync("alert", "수정에 실패했습니다.");
		}
	}

	private void goList()
	{
		NavManager.NavigateTo("/notice");
	}
	private async Task DeleteNotice(int id)
	{
		bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "정말 삭제하시겠습니까?");
		if (confirmed)
		{
			var success = await _NoticeService.DeleteNoticeAsync(id);
			if (success)
			{
				await LoadPage(PageNum); // 목록 새로고침
			}
			else
			{
				await JSRuntime.InvokeVoidAsync("alert", "삭제에 실패했습니다.");
			}
		}
	}
}
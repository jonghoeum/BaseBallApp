	<div>
		<div class="paging_area">
			<div class="paging">
				<!-- 이전 10페이지 버튼 -->
				<button type="button" class="btn_page prev"
						@onclick="PreviousPageGroup"
						disabled="@(PageNum <= 10)">
					<span class="blind">이전 10</span>
				</button>

				<div class="go_num">
					@for (int i = StartPage; i <= EndPage && i <= TotalPages; i++)
					{
						int pg = i;
						<a href="javascript:void(0);"
						   class="@(pg == PageNum ? "on" : "")"
						   style="cursor: pointer;"
						   @onclick="() => LoadPage(pg)">
							@pg
						</a>
					}
				</div>

				<!-- 다음 10페이지 버튼 -->
				<button type="button" class="btn_page next"
						@onclick="NextPageGroup"
						disabled="@(EndPage >= TotalPages)">
					<span class="blind">다음 10</span>
				</button>
			</div>
		</div>
	</div>

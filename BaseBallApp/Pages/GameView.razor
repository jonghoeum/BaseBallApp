    private async Task RegisterGames() //수정
    {
        var sucess = await _GameService.EditGameAsync(regGameWithScores);
        await ReloadData();

        isModalVisible = false;
        await js.InvokeVoidAsync("alert", "정상적으로 등록되었습니다.");
        return;
    }

    private async Task ReloadData()
    {
        Games = await _GameService.GetGamesAsync();
        GameScores = await _GameService.GetGamesScoreAsync();

        var selectedGame = Games.FirstOrDefault(x => x.IDX == GameId);
        var selectedScores = GameScores.Where(x => x.REF_IDX == GameId.ToString()).ToList();

        if (selectedGame is not null)
        {
            gameWithScores = new GameWithScores
                {
                    Game = selectedGame,
                    Scores = selectedScores
                };

            //만약 경기예정으로, Score가 없이 등록됐다면, Scores 에 홈팀, 어웨이팀의 빈스코어를 추가해준다.
            if (selectedScores.Count() == 0)
            {
                selectedScores = new List<GameScoreClass>
                {
                    new GameScoreClass(),
                    new GameScoreClass()
                };
            }
            else
            {
                //업데이트
                selectedScores.ForEach(score => score.UPDATE = true);
            }
            regGameWithScores = new GameWithScores
                {
                    Game = selectedGame,
                    Scores = selectedScores
                };
        }
        else
        {
            gameWithScores = null;
            regGameWithScores = null;
        }

        preDate = gameWithScores.Game.STARTTIME?.ToString("yyyyMM", new System.Globalization.CultureInfo("ko-KR"));
    }

    private void CloseModal()
    {
        isModalVisible = false;
    }
    private async Task ConfirmDelete(string id)
    {
        bool confirmed = await js.InvokeAsync<bool>("confirm", "게임정보를 삭제하시겠습니까?");
        if (confirmed)
        {
            var rs = await _GameService.DeleteItemAsync(id);
            NavManager.NavigateTo("/game/init");
        }
        //await ReloadData();
    }
    public void Dispose()
    {
        LoginState.OnChange -= StateHasChanged;
    }
}
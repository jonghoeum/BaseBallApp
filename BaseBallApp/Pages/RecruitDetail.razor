@page "/recruit/detail/{Idx:int}"

@using System.Globalization
@using BaseBallApp.Data;
@using BaseBallApp.Shared;
@using BaseBallApp.Shared.Models;
@using Blazorise.RichTextEdit;

@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@inject RecruitService _RecruitService


<div class="title_area" style="height: 782px;">
    <h3>Fan</h3>
</div>

<section class="content_block fan_news">
    <div>
        <div class="tab_menu">
            <ul>
                <li class="active" id="notice"><a @onclick="GoBack" style="cursor:pointer"><span></span>구단소식</a></li>
            </ul>
        </div>
    </div>

    <h4 class="blind">메티스 구단의 뉴스를 전해드립니다.</h4>

    <div class="notice_view">
        <div class="view_hd">
            <!-- 제목 -->
            <strong class="tit">@recruit?.Title</strong>

            <div class="write">
                <div class="left">
                    <p><span class="tt">작성일</span><span class="txt">@recruit?.CreatedAt.ToString("yyyy.MM.dd")</span></p>
                    <p><span class="tt">조회수</span><span class="txt">@recruit?.ViewCount</span></p>
                </div>
                <div class="right">
                    <div class="sns">
                        <a style="cursor: pointer" onclick="shareTwitter()" class="twitter"><span class="blind">Twitter</span></a>
                        <a style="cursor: pointer" onclick="shareFacebook()" class="facebook"><span class="blind">Facebook</span></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 내용 -->
        <div class="view_detail">
            @if (!string.IsNullOrEmpty(recruit?.Content))
            {
                @((MarkupString)recruit.Content)
            }
            
            <div class="attach_area">
                @if (!string.IsNullOrEmpty(recruit?.FileName1))
                {
                    var downUrl1 = _RecruitService.GetDownloadUrl(recruit.FilePath1);
                    <a class="underline btn_attach_down" target="_blank" href="@downUrl1" title="@recruit.FileName1">
                        @recruit.FileName1
                    </a>
                }
                @if (!string.IsNullOrEmpty(recruit?.FileName2))
                {
                    var downUrl1 = _RecruitService.GetDownloadUrl(recruit.FilePath2);
                    <a class="underline btn_attach_down" target="_blank" href="@downUrl1" title="@recruit.FileName2">
                        @recruit.FileName2
                    </a>
                }
                @* <a class="underline btn_attach_down" href="/download/attach.do?&amp;id=18717" title="한화이글스 신축구장 식음매장 운영사업자 모집 공고.zip">
                    한화이글스 신축구장 식음매장 운영사업자 모집 공고.zip
                </a> *@
            </div>
            
        </div>
    </div>

    @* <div class="page_fast_move">
        <ul>
            <li class="prev">
                <div class="col">이전글</div>
                <div class="col">이전글이 없습니다.</div>
            </li>
            <li class="next">
                <div class="col">다음글</div>
                <div class="col"><a href="#">다음글 제목</a></div>
                <div class="col">작성일 <span>2025.07.02</span></div>
                <div class="col">조회수 <span>123</span></div>
            </li>
        </ul>
    </div> *@

    <div class="paginate btn_area center">
        <a @onclick="GoBack" class="btn_com" style="cursor:pointer"><span></span>목록</a>
    </div>
</section>

@code {
    [Parameter] public int Idx { get; set; }
    private RecruitClass? recruit;

    protected override async Task OnInitializedAsync()
    {
        recruit = await _RecruitService.GetRecruitByIdAsync(Idx);
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/Recruitment");
    }
}
<style>
	.gallery-card {
		aspect-ratio: 1 / 1; /* 정사각형 카드 */
		position: relative;
		background-color: #f0f0f0;
		cursor: pointer;
	}

		.gallery-card img {
			object-fit: cover;
			transition: transform 0.3s ease;
			height: 100%;
			width: 100%;
		}

		.gallery-card:hover img {
			transform: scale(1.05);
		}

	.gallery-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.4);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.gallery-card:hover .gallery-overlay {
		opacity: 1;
	}
	/* 필요시 추가할 수 있는 스타일 */
	.gallery-card .btn-danger {
		z-index: 10;
		padding: 0.25rem 0.5rem;
		font-size: 0.85rem;
	}
</style>
    <div class="title_area" style="height: 782px;">
        <h3>Gallery</h3>
    </div>


	<section id="clubCont" class="content_block">
		<div>

			<div class="tab_menu">
				<ul>
					<li class="active" id="PCFAGL"><a href="/FA/GL/PCFAGL01.do"><span></span>갤러리</a></li>
				</ul>
			</div>

		</div>
		@if (LoginState.IsLoggedIn && LoginState.Role == "Admin")
		{
			<div style="display: flex; flex-wrap: wrap; justify-content: flex-end;">
				<button class="btn btn-primary" @onclick="() => isModalVisible = true">등록</button>
			</div>
		}
		<h4 class="bold_title">다채로운 <span class="txt_hanwha">메티스</span>의<br> 모습을 만나보세요.</h4>
		<div class="container py-4">
			<div class="row g-3">
				@foreach (var item in GalleryList)
				{
				<div class="col-6 col-md-4 col-lg-3">
					<div class="gallery-card position-relative overflow-hidden rounded">
						<!-- 삭제 버튼 -->
						@if (LoginState.IsLoggedIn && LoginState.Role == "Admin")
						{
							<button class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1"
							title="삭제"
							@onclick="() => DeleteImage(item)">
								✕
							</button>
						}
						<!-- 이미지 -->
							<img src="@_GalleryService.GetImageUrl(item.FILE)" alt="@item.TITLE" class="img-fluid w-100 h-100 object-cover" />
							<!-- 오버레이 -->
							<div class="gallery-overlay d-flex align-items-center justify-content-center">
								<span class="text-white fw-bold">@item.TITLE</span>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
		<p class="paging_area btn_area blind">
		<a href="javascript:void(0);" type="button" onclick="moreGalleryView()"><span></span>더보기</a>
		</p> <!-- //.paging_area -->

	</section>

@if (isModalVisible)
{
	<div class="modal show d-block" tabindex="-1">
		<div class="modal-dialog modal-xl">
			<div class="modal-content">
				<EditForm Model="regGal" OnValidSubmit="RegisterGallerys">
					<div class="modal-header" style="color:black;">
						<h5 class="modal-title">등록</h5>
						<button type="button" class="btn-close" @onclick="e => CloseModal()"></button>
					</div>
					<div class="modal-body">
						<InputText @bind-Value="regGal.TITLE" class="form-control mb-2" placeholder="제목" />
						<ValidationMessage For="@(() => regGal.TITLE)" />
						@* <InputText @bind-Value="regGal.CONTENT" class="form-control mb-2" placeholder="내용" />
						<ValidationMessage For="@(() => regGal.CONTENT)" /> *@
						@* <DnDFileUploader /> *@
						<div style="display:flex; justify-content: center;"><img src="@PreviewUrl" style="max-width:100%;" /></div>
						<FileUploader OnFileSelected="HandleFileSelected" />
					</div>
					<div class="modal-footer">
						<button class="btn btn-secondary" type="button" @onclick="e => CloseModal()">닫기</button>
						<button class="btn btn-primary" type="submit">등록</button>
					</div>
				</EditForm>
			</div>
		</div>
	</div>
	<div class="modal-backdrop fade show"></div>
}



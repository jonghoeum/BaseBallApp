    private async Task RegisterGames() //등록
    {
        //var success = await _DataService.InsertPlayerAsync(player);
        var sucess = await _GameService.InsertGameAsync(regGameWithScores);
        //var success = true;

        if (sucess)
        {
            responseMessage = "경기 성공!";
            //playersList = await _DataService.GetPlayersAsync(); // 목록 갱신
            isModalVisible = false;
            
            await SetParametersAsync();
            Games = await _GameService.GetGamesAsync();
            GameScores = await _GameService.GetGamesScoreAsync();
            //Dictionary<DateTime, List<GameClass>> game = new();
            foreach (var gm in Games)
            {
                if (gm.STARTTIME.HasValue)
                {
                    var gameDate = gm.STARTTIME.Value.Date;

                    if (!GameSchedule.ContainsKey(gameDate))
                    {
                        GameSchedule[gameDate] = new List<GameWithScores>();
                    }

                    var scores = GameScores
                                    .Where(s => s.REF_IDX == gm.IDX.ToString()) // GAMEID로 두 개의 점수 매칭
                                    .ToList();

                    GameSchedule[gameDate].Add(new GameWithScores
                        {
                            Game = gm,
                            Scores = scores
                        });
                }
            }

            await js.InvokeVoidAsync("alert", "정상적으로 등록되었습니다.");
            return;
        }
        else
        {
            responseMessage = "등록 실패.";
            await js.InvokeVoidAsync("alert", "등록시 문제가 발생하였습니다. 관리자에게 문의해주세요");
            return;
        }
    }
    private void OnDateTimeChanged(string? newValue)
    {
        if (DateTime.TryParse(newValue, out var parsed))
        {
            regGameWithScores.Game.STARTTIME = parsed;
        }
    }

    public void Dispose()
    {
        LoginState.OnChange -= StateHasChanged;
    }

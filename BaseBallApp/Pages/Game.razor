@if (isModalVisible)
{
	<div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-xl">
			<div class="modal-content">
                <EditForm Model="gameWithScores" OnValidSubmit="RegisterGames">
					<DataAnnotationsValidator />
					<div class="modal-header" style="color:black;">
						<h5 class="modal-title">등록</h5>
						<button type="button" class="btn-close" @onclick="e => CloseModal()"></button>
					</div>

					<div class="modal-body">
                        <h6 style="color:black;margin-bottom:5px;">경기 정보</h6>
                        <ValidationMessage For="@(() => regGameWithScores.Game.STATUS)" />
                        <InputText @bind-Value="regGameWithScores.Game.HOMETEAM" class="form-control mb-2" placeholder="홈팀" />
                        <InputText @bind-Value="regGameWithScores.Game.AWAYTEAM" class="form-control mb-2" placeholder="원정팀" />
                        <InputText @bind-Value="regGameWithScores.Game.PLACE" class="form-control mb-2" placeholder="경기장소" />
                        @* <InputDate @bind-Value="regGameWithScores.Game.STARTTIME" class="form-control mb-2" /> *@
                        <input type="datetime-local"
                               class="form-control mb-2"
                               value="@startTimeString"
                               @oninput="e => OnDateTimeChanged(e.Value?.ToString())" />
                        <InputText @bind-Value="regGameWithScores.Game.CATEGORY" class="form-control mb-2" placeholder="카테고리" />
                        <label for="StateSelect" class="form-label" style="color:black;">제품 선택:</label>
                        <InputSelect id="StateSelect" @bind-Value="regGameWithScores.Game.STATUS" class="form-select">
                            <option value="">경기상태</option>
                            @foreach (var option in regGameWithScores.Game.Options)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </InputSelect>

                        <h6 class="mt-4"style="color:black;margin-bottom:5px;">점수 정보</h6>
                        @if (regGameWithScores?.Scores != null && regGameWithScores.Scores.Count >= 2)
                        {
                            <table class="table table-bordered text-center">
                                <thead>
                                    <tr>
                                        <th>팀명</th>
                                        @for (int i = 1; i <= 9; i++)
                                        {
                                            <th>@i</th>
                                        }
                                        <th>R</th>
                                        <th>H</th>
                                        <th>E</th>
                                        <th>B</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < regGameWithScores.Scores.Count; i++)
                                    {
                                        var idx = i;
                                        <tr>
                                            <td><InputText @bind-Value="regGameWithScores.Scores[idx].TEAM" class="form-control mb-1" placeholder="팀명" /></td>
                                            <td><InputNumber @bind-Value="regGameWithScores.Scores[idx].S1" class="form-control form-control-sm" /></td>
                                            <td><InputNumber @bind-Value="regGameWithScores.Scores[idx].S2" class="form-control form-control-sm" /></td>
                                            <td><InputNumber @bind-Value="regGameWithScores.Scores[idx].S3" class="form-control form-control-sm" /></td>
                                            <td><InputNumber @bind-Value="regGameWithScores.Scores[idx].S4" class="form-control form-control-sm" /></td>
                                            <td><InputNumber @bind-Value="regGameWithScores.Scores[idx].S5" class="form-control form-control-sm" /></td>
                                            <td><InputNumber @bind-Value="regGameWithScores.Scores[idx].S6" class="form-control form-control-sm" /></td>
                                            <td><InputNumber @bind-Value="regGameWithScores.Scores[idx].S7" class="form-control form-control-sm" /></td>
                                            <td><InputNumber @bind-Value="regGameWithScores.Scores[idx].S8" class="form-control form-control-sm" /></td>
                                            <td><InputNumber @bind-Value="regGameWithScores.Scores[idx].S9" class="form-control form-control-sm" /></td>
                                            <td><InputNumber @bind-Value="regGameWithScores.Scores[idx].RUNS" class="form-control mb-1" placeholder="득점" /></td>
                                            <td><InputNumber @bind-Value="regGameWithScores.Scores[idx].HITS" class="form-control mb-1" placeholder="안타" /></td>
                                            <td><InputNumber @bind-Value="regGameWithScores.Scores[idx].ERRORS" class="form-control mb-1" placeholder="에러" /></td>
                                            <td><InputNumber @bind-Value="regGameWithScores.Scores[idx].BALLS" class="form-control mb-1" placeholder="볼넷" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
					</div>

					<div class="modal-footer">
						<button class="btn btn-secondary" type="button" @onclick="e => CloseModal()">닫기</button>
						<button class="btn btn-primary" type="submit">등록</button>
					</div>
				</EditForm>
			</div>
		</div>
	</div>
	<div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter]
    public string Pdate { get; set; } = "";
    private DateTime CurrentMonth = DateTime.Today;
    //private DateTime CurrentMonth = DateTime.Today;
    // private string[] DayNames = CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames;
    private string[] DayNames = new CultureInfo("en-US").DateTimeFormat.AbbreviatedDayNames;
    //private Dictionary<DateTime, string> GameSchedule = new();
    //private Dictionary<DateTime, List<GameClass>> GameSchedule = new();
    Dictionary<DateTime, List<GameWithScores>> GameSchedule = new();
    private List<GameClass> Games = new();
    private List<GameScoreClass> GameScores = new();
    private bool isModalVisible = false;
    private GameWithScores gameWithScores = new()
    {
            Game = new GameClass(),
            Scores = new List<GameScoreClass>
            {
                new GameScoreClass(),
                new GameScoreClass()
            }
    };
    private string responseMessage = "";
    private bool isEditModalVisible = false;
    private GameWithScores regGameWithScores = new()
        {
            Game = new GameClass(),
            Scores = new List<GameScoreClass>
    {
        new GameScoreClass(),
        new GameScoreClass()
    }
        };
    private string? startTimeString;
    protected override async Task OnInitializedAsync()
    {
        await SetParametersAsync();
        Games = await _GameService.GetGamesAsync();
        GameScores = await _GameService.GetGamesScoreAsync();
        //Dictionary<DateTime, List<GameClass>> game = new();
        foreach (var gm in Games)
        {
            if (gm.STARTTIME.HasValue)
            {
                var gameDate = gm.STARTTIME.Value.Date;

                if (!GameSchedule.ContainsKey(gameDate))
                {
                    GameSchedule[gameDate] = new List<GameWithScores>();
                }

                var scores = GameScores
                                .Where(s => s.REF_IDX == gm.IDX.ToString()) // GAMEID로 두 개의 점수 매칭
                                .ToList();

                GameSchedule[gameDate].Add(new GameWithScores
                    {
                        Game = gm,
                        Scores = scores
                    });
            }
        }
        LoginState.OnChange += StateHasChanged;
    }
    private async Task SetParametersAsync()
    {
        if (string.IsNullOrEmpty(Pdate))
        {
            CurrentMonth = DateTime.Today;
        }
        else
        {
            // Pdate를 DateTime으로 파싱 시도
            if (DateTime.TryParseExact(Pdate + "01", "yyyyMMdd", null, System.Globalization.DateTimeStyles.None, out DateTime parsedDate))
            {
                // 파싱 성공하면 해당 날짜로 설정
                CurrentMonth = parsedDate;
            }
            else
            {
                // 파싱 실패 시 기본값 (오늘 날짜) 또는 예외 처리
                Console.WriteLine($"경고: Pdate '{Pdate}'를 날짜 형식으로 변환할 수 없습니다. 오늘 날짜를 사용합니다.");
                CurrentMonth = DateTime.Today;
            }
        }
    }

    private List<List<DateTime>> CalendarWeeks => GenerateCalendar(CurrentMonth);

    private List<List<DateTime>> GenerateCalendar(DateTime month)
    {
        var firstDayOfMonth = new DateTime(month.Year, month.Month, 1);
        var startDay = firstDayOfMonth.AddDays(-(int)firstDayOfMonth.DayOfWeek);
        var weeks = new List<List<DateTime>>();

        for (int i = 0; i < 6; i++)
        {
            var week = new List<DateTime>();
            for (int j = 0; j < 7; j++)
            {
                week.Add(startDay.AddDays(i * 7 + j));
            }
            weeks.Add(week);
        }

        return weeks;
    }

    private string GetDayClass(DateTime day)
    {
        if (day.Month != CurrentMonth.Month)
        {
            //return $"<div class='td_conts prev_blank'><div class='inner'><span class='date blind'>{day.Day}</span>";
            return $"<div class='td_conts prev_blank'><div class='inner'><span class='date blind'>{day.Day}</span></div></div>";
        }
        else
        {
            var key = day.Date;
            string html = "";
            //경기가 존재하면
            if (GameSchedule.ContainsKey(key) && GameSchedule[key].Count > 0)
            {
                //var game = GameSchedule[key][0]; // 예시로 첫 번째 경기만 표시
                var gameWithScores = GameSchedule[key][0]; // 첫 경기만 표시
                var game = gameWithScores.Game;
                var scores = gameWithScores.Scores;
                string imageUrl = _GameService.GetImageUrl("/uploads/blank_symbol.png"); //기본 블링크 이미지
                html = "<div class='td_conts'>";
                html += "<div class='inner'>";
                //html += "<div class='col date'>{day:yyyy-MM-dd}(화)</div>";

                html += $"<div class='col date'>{game.STARTTIME?.ToString("yyyy - MM - dd(ddd)", new System.Globalization.CultureInfo("ko-KR"))}</div>";
                html += $"<div class='col time'>{game.STARTTIME?.ToString("HH: mm")}</div>";
                html += $"<div class='col place'>{game.PLACE}</div>";
                html += "<div class='col gm_rs'>";
                html += "<p>";

                string resultText = game.STATUS switch
                {
                    0 => "[예정]",
                    1 => "[승리]",
                    2 => "[패배]",
                    3 => "[무승부]",
                    4 => "[취소]",
                    _ => "[미정]"
                };
                //0:예정, 1:승리, 2:패배, 3:무승부, 4:경기취소
                html += $"<span class='win'>{resultText}</span> <span class='club'>{game.HOMETEAM}</span>";
                html += "<strong class='det'>:</strong>";
                html += $"<span class='club'>{game.AWAYTEAM}</span>";
                html += "</p>";
                html += "</div>";
                html += $"<div class='col cate'>정규</div>";
                html += $"<div class='lst date'>{day.Day}<span class='blind'>{day:ddd}</span></div>";
                html += "<div class='lst club_logo'>";

                if (game.HOMETEAM == "메티스" || game.HOMETEAM == "METIS")
                { //METIS가 홈팀인지 AWAY팀인지 확인해야한드아.
                    if(!string.IsNullOrEmpty(game.AwayTeamFile))
                        imageUrl = _GameService.GetImageUrl(game.AwayTeamFile);
                }
                else if(game.AWAYTEAM == "메티스" || game.AWAYTEAM == "METIS")
                {
                    if (!string.IsNullOrEmpty(game.HomeTeamFile))
                        imageUrl = _GameService.GetImageUrl(game.HomeTeamFile);

                    else if (!string.IsNullOrEmpty(game.AwayTeamFile))
                        imageUrl = _GameService.GetImageUrl(game.AwayTeamFile);
                }
                
                html += $"<a href='/gameview/{game.IDX}' class='inner'> <img src='{imageUrl}' alt='엠블럼'> </a>";
                //html += $"<span>{game.HOMETEAM+"VS"+game.AWAYTEAM}</span>";
                html += "</div>";
                html += "<div class='lst gm_rs'>";
                html += "<span class='rs'>";
                html += $"<span class='win'>{resultText}</span>"; //승 점수 or 패 점수, or 취소 or 예정
                html += "</span>";
                string targetTeam = "메티스"; // 기준이 되는 팀
                if (game.STATUS != 4 && game.STATUS != 0)
                {
                    if (scores != null && scores.Count == 2)
                    {
                        var homeScore = scores.FirstOrDefault(s => s.TEAM == game.HOMETEAM)?.RUNS;
                        var awayScore = scores.FirstOrDefault(s => s.TEAM == game.AWAYTEAM)?.RUNS;
                        if(game.HOMETEAM == targetTeam)
                        {
                            html += $"{homeScore} : {awayScore}";
                        }
                        else if(game.AWAYTEAM == targetTeam)
                        {
                            html += $"{awayScore} : {homeScore}";
                        }
                        else
                        {
                            html += $"{homeScore} : {awayScore}";
                        }

                    }
                    //html += $"<strong class='det'>{}:{}</strong>";
                }
                html += "</div>";
                html += "</div>";
                html += "</div>";
            }
            else
            {
                //경기가 없는날
                html = "<div class='td_conts blank'>";
                html += "<div class='inner'>";
                html += "<div class='lst date'>" + day.Day + "</div>";
                html += "</div>";
                html += "</div>";
            }

            return html;

        }
        //return "text-muted";
        // if (day.DayOfWeek == DayOfWeek.Sunday)
        //     return "text-danger";
        // if (day.DayOfWeek == DayOfWeek.Saturday)
        //     return "text-primary";
        //return "";
    }

    private void PreviousMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
    }

    private void NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
    }
    private void CloseModal()
    {
        isModalVisible = false;
